# Copy to .env.local (gitignored). All three are needed for "Continue with
# Google"; without them the button is hidden and email/password still works.

# Cognito hosted UI domain, without https://
VITE_COGNITO_DOMAIN=your-pool.auth.il-central-1.amazoncognito.com

# App client ID. A public client with no secret - PKCE covers that.
VITE_COGNITO_CLIENT_ID=your-app-client-id

# Must exactly match an allowed callback URL on the app client.
VITE_REDIRECT_URI=http://localhost:5173/callback

# Only for a deployed build. The dev server proxies /api to localhost:8000.
# VITE_API_BASE_URL=https://your-api-id.execute-api.il-central-1.amazonaws.com
