# Copy to .env for local development. Everything has a working default except
# the Cognito values, which are needed for "Continue with Google".

# DynamoDB - see docs/erd.md. AWS credentials come from `aws configure`.
DYNAMO_TABLE=LearnSprint
AWS_REGION=il-central-1

# Signs the app's own email/password tokens. Set a real value anywhere but local dev.
JWT_SECRET=dev-secret-change-me

# The backend's own Anthropic key for AI content analysis (FR2.7). Leave empty
# and every upload uses the keyword heuristic instead. Never shared with the browser.
SYSTEM_ANTHROPIC_API_KEY=

# Cognito user pool with Google as an identity provider. Leave empty to turn
# Google sign-in off; email/password keeps working.
COGNITO_USER_POOL_ID=il-central-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_REGION=il-central-1

# Google Calendar sync (FR6.2) - a separate Google OAuth client, not the Cognito
# one; see docs/deployment-setup.md for the console steps. Leave empty to turn
# the feature off; the Calendar page then hides the Google controls.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/calendar/google/callback
